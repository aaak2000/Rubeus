// Prisma schema for the Hebrew calendar system.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  google
  microsoft
  caldav
}

enum HebrewRecurrenceKind {
  yahrzeit
  birthday
  anniversary
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  settings     UserSettings?
  calendars    Calendar[]
  connections  ProviderConnection[]
  refreshTokens RefreshToken[]
  yahrzeits    Yahrzeit[]
  pushSubscriptions PushSubscription[]
}

/// A issued refresh token, stored only as a hash so a database read cannot
/// mint sessions. Rotated on every use and revocable on sign-out.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token; the token itself is never persisted.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  /// Set when this token was rotated, pointing at its replacement.
  replacedById String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Per-user preferences, including the location used for zmanim.
/// Where the user's day starts. The Hebrew day begins at sunset, so `sunset`
/// files an evening event under the following Hebrew date — which is what the
/// date on a Hebrew calendar actually means. `midnight` is offered for people
/// who would rather see the civil day.
enum DayBoundary {
  midnight
  sunset
}

model UserSettings {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  il            Boolean     @default(false)
  latitude      Float?
  longitude     Float?
  tzid          String      @default("Asia/Jerusalem")
  elevation     Float?
  candleMinutes Int         @default(18)
  locale        String      @default("he")
  dayBoundary   DayBoundary @default(sunset)
}

model Calendar {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String?
  isDefault    Boolean             @default(false)
  /// When this calendar mirrors an external provider calendar.
  connectionId String?
  connection   ProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  providerCalendarId String?
  events       Event[]
  mappings     SyncMapping[]
  syncStates   SyncState[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  calendarId  String
  calendar    Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  title       String
  description String?
  location    String?
  /// Anchor instants stored in UTC.
  startUtc    DateTime
  endUtc      DateTime
  allDay      Boolean  @default(false)
  /// Standard iCalendar recurrence (Gregorian), if any.
  rrule       String?
  /// Hebrew-date recurrence: kind + the original Gregorian date it anchors on.
  hebrewRecurrence     HebrewRecurrenceKind?
  hebrewRecurrenceDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([calendarId, startUtc])
}

/// A linked external calendar account (OAuth tokens stored encrypted).
model ProviderConnection {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       Provider
  accountEmail   String?
  accessTokenEnc String
  refreshTokenEnc String?
  expiresAt      DateTime?
  scope          String?
  /// CalDAV collection URL (caldav provider only).
  caldavUrl      String?
  calendars      Calendar[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

/// Maps one local event to its counterpart in a provider calendar.
model SyncMapping {
  id             String   @id @default(cuid())
  calendarId     String
  calendar       Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  localEventId   String
  providerId     String
  etag           String?
  lastSyncedHash String?
  updatedAt      DateTime @updatedAt

  @@unique([calendarId, localEventId])
  @@unique([calendarId, providerId])
}

/// Incremental sync cursor per calendar.
model SyncState {
  id         String   @id @default(cuid())
  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  token      String?
  updatedAt  DateTime @updatedAt

  @@unique([calendarId])
}

/// Where an ad may be shown. Interstitials carry house inventory only —
/// Google requires its own tags for interstitial formats, so third-party
/// network creatives are never wrapped in our dialog.
enum AdPlacement {
  interstitial
  inline
}

/// A directly-sold advertiser campaign.
///
/// This is an allowlist: nothing appears here without being approved, which is
/// what makes the inventory suitable for the audience. Network fill (AdSense)
/// is configured separately and never served through the interstitial.
model AdCampaign {
  id          String      @id @default(cuid())
  /// The advertiser's name, shown to users for transparency.
  advertiser  String
  title       String
  body        String?
  imageUrl    String?
  targetUrl   String
  placement   AdPlacement @default(interstitial)
  /// Relative share of impressions among eligible campaigns.
  weight      Int         @default(1)
  active      Boolean     @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  impressions Int         @default(0)
  clicks      Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([active, placement])
}

/// A name the user keeps for memorial observance.
///
/// The yahrzeit recurs by the Hebrew calendar, so what is stored is the
/// Gregorian date of death plus whether it fell after sunset — together they
/// fix the Hebrew date. Storing a converted Hebrew date instead would lose
/// that distinction, and getting it wrong moves the observance by a day every
/// year for as long as the record lives.
model Yahrzeit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// How the user refers to them — "אבא", or a full name.
  name        String
  /// The name used for keil malei / kaddish: פלוני בן/בת פלוני.
  hebrewName  String?
  /// Relationship, e.g. "אב", "סבתא". Free text: families differ.
  relation    String?
  /// Gregorian date of death, stored date-only at UTC midnight.
  deathDate   DateTime @db.Date
  /// True when death occurred after sunset, making the Hebrew date the next day.
  afterSunset Boolean  @default(false)
  note        String?
  /// Days ahead to remind, e.g. [7, 1, 0]. Empty means no reminders.
  remindDaysBefore Int[] @default([7, 1, 0])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries  ReminderDelivery[]

  @@index([userId])
}

enum ReminderChannel {
  inapp
  push
  email
}

/// A browser push endpoint. One row per device the user opted in on.
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

/// One reminder that has gone out.
///
/// The unique key is what makes dispatch idempotent: a scheduler that runs
/// twice, or a deploy that restarts it mid-run, must not send the same
/// memorial reminder again.
model ReminderDelivery {
  id         String          @id @default(cuid())
  yahrzeitId String
  yahrzeit   Yahrzeit        @relation(fields: [yahrzeitId], references: [id], onDelete: Cascade)
  /// The Hebrew year of the occurrence being reminded about.
  hebrewYear Int
  daysBefore Int
  channel    ReminderChannel
  sentAt     DateTime        @default(now())

  @@unique([yahrzeitId, hebrewYear, daysBefore, channel])
  @@index([sentAt])
}
