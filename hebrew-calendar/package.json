{
  "name": "hebrew-calendar",
  "version": "0.1.0",
  "private": true,
  "description": "Smart standalone Hebrew calendar management system with two-way sync to common calendars (Google, Microsoft, CalDAV, ICS).",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @hcal/api start:dev",
    "dev:web": "pnpm --filter @hcal/web dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
